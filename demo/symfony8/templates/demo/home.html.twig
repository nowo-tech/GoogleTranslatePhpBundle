{% extends 'base.html.twig' %}

{% block title %}Google Translate PHP Bundle — Demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'GoogleTranslatePhpBundle',
        intro: 'FrankenPHP worker-safe translator',
    }) }}
{% endblock %}

{% block body %}
    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            <p>
                <span class="nowo-ui-badge nowo-ui-badge--info">{{ version_badge }}</span>
                Profile timeouts (REQ-RUNTIME-001):
                <code class="nowo-ui-code">timeout={{ timeout }}s</code>,
                <code class="nowo-ui-code">connect_timeout={{ connect_timeout }}s</code>
            </p>

            {{ form_start(form) }}
                {% for child in form %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(form) }}
        </div>
    </section>

    {% if error %}
        <div class="nowo-ui-flash nowo-ui-flash--error" role="alert"><strong>Error:</strong> {{ error }}</div>
    {% endif %}

    {% if translated is not null %}
        <section class="nowo-ui-card">
            <header class="nowo-ui-card__header"><h2 class="nowo-ui-card__title">Result</h2></header>
            <div class="nowo-ui-card__body">
                <p><strong>Detected source:</strong> {{ detected ?? 'n/a' }}</p>
                <pre class="nowo-ui-code-block">{{ translated }}</pre>
            </div>
        </section>
    {% endif %}
{% endblock %}
