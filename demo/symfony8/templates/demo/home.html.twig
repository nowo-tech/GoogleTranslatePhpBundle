{% extends 'base.html.twig' %}

{% block title %}Google Translate PHP Bundle — Demo{% endblock %}

{% block body %}
    <h1>GoogleTranslatePhpBundle</h1>
    <p><span class="badge">{{ version_badge }}</span> · FrankenPHP worker-safe translator</p>

    <p>
        Profile timeouts (REQ-RUNTIME-001):
        <code>timeout={{ timeout }}s</code>,
        <code>connect_timeout={{ connect_timeout }}s</code>
    </p>

    <form method="post" action="{{ path('demo_home') }}">
        <label for="text">Text to translate (auto-detect → Spanish)</label>
        <textarea id="text" name="text" rows="4" cols="60">{{ input }}</textarea>
        <p><button type="submit">Translate</button></p>
    </form>

    {% if error %}
        <p class="error"><strong>Error:</strong> {{ error }}</p>
    {% endif %}

    {% if translated is not null %}
        <h2>Result</h2>
        <p><strong>Detected source:</strong> {{ detected ?? 'n/a' }}</p>
        <pre>{{ translated }}</pre>
    {% endif %}
{% endblock %}
